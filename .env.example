# RAGLab — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is git-ignored. Never commit secrets.

# ── Infrastructure ──────────────────────────────────────────────────────────
RAGLAB_QDRANT_HOST=localhost
RAGLAB_QDRANT_PORT=6333

RAGLAB_POSTGRES_DSN=postgresql+asyncpg://raglab:raglab@localhost:5432/raglab

RAGLAB_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── LLM Providers ───────────────────────────────────────────────────────────
# Azure OpenAI (primary)
RAGLAB_AZURE_OPENAI_API_KEY=
RAGLAB_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
RAGLAB_AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI
RAGLAB_OPENAI_API_KEY=

# Anthropic
RAGLAB_ANTHROPIC_API_KEY=

# Ollama (local, no key needed)
RAGLAB_OLLAMA_BASE_URL=http://localhost:11434

# ── Logging ─────────────────────────────────────────────────────────────────
RAGLAB_LOG_LEVEL=INFO
RAGLAB_JSON_LOGS=false
